{
  "name": "toward-us",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "check:runtime": "node scripts/check-mobile-runtime.mjs",
    "update:runtime-lock": "node scripts/update-mobile-runtime-lock.mjs",
    "test:runtime": "playwright test",
    "test:responsive": "playwright test tests/responsive-site.spec.ts",
    "test:demo": "playwright test --config=playwright.demo.config.ts",
    "test:relationship": "playwright test --config=playwright.relationship.config.ts",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "predev": "npm run check:runtime",
    "dev": "vite",
    "dev:full": "node server/index.mjs",
    "prebuild": "npm run check:runtime",
    "build": "tsc && vite build && node scripts/prepare-sites-build.mjs",
    "start": "node server/index.mjs --production",
    "test:app": "node --test tests/app-server.test.mjs tests/render-blueprint.test.mjs tests/lifecycle-store.test.mjs tests/personal-privacy.test.mjs tests/memory-lifecycle.test.mjs tests/reminder-delivery.test.mjs tests/decision-lifecycle.test.mjs tests/assistant-workflows.test.mjs",
    "verify:deploy": "node scripts/verify-deployment.mjs",
    "test:postgres": "node --test tests/postgres-lifecycle.test.mjs"
  },
  "dependencies": {
    "@fontsource/roboto": "5.2.10",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-icons": "1.3.2",
    "@use-gesture/react": "10.3.1",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "motion": "12.42.2",
    "openai": "^7.5.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/express": "^5.0.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "7.0.2",
    "vite": "8.1.3"
  }
}
