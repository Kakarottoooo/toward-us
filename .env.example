# Keep secrets outside the repository. The server reads these values only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_TRANSCRIBE_MODEL=gpt-live-transcribe
# Local dogfooding only: claude-cli routes text AI calls through the signed-in `claude` CLI (Claude subscription). Audio stays on OpenAI.
AI_PROVIDER=
CLAUDE_CLI_MODEL=haiku
PORT=5173
DATABASE_URL=
DB_POOL_SIZE=5
NODE_ENV=development
TOWARD_US_DATA_FILE=
# Local dev only: hostnames allowed to reach the Vite dev server, e.g. a Tailscale serve name (comma-separated).
DEV_ALLOWED_HOSTS=
TOWARD_US_BASE_URL=
# Password-reset mail and optional third-party sign-in. Both providers must be configured for social buttons to appear.
RESEND_API_KEY=
EMAIL_FROM=
OAUTH_PUBLIC_ORIGIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_SIGNIN_CLIENT_ID=
APPLE_SIGNIN_TEAM_ID=
APPLE_SIGNIN_KEY_ID=
APPLE_SIGNIN_PRIVATE_KEY=
# Stable base64-encoded 32-byte key for the encrypted Apple token used on account deletion.
APPLE_SIGNIN_TOKEN_KEY=
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
SENDBLUE_FROM_NUMBER=
SENDBLUE_WEBHOOK_SECRET=
SENDBLUE_GROUPS_ENABLED=false
# Local only: without the three Sendblue credentials, outbound iMessages are appended here as JSON lines.
SENDBLUE_DRYRUN_FILE=
FCM_SERVICE_ACCOUNT_JSON=
